<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Educational Program Assessment</title>

  <style>
    :root {
      --navy: #00356b;
      --blue: #286dc0;
      --teal: #00a6a6;
      --purple: #6b5bd2;
      --gold: #b38b00;
      --ink: #17324d;
      --muted: #5c7184;
      --line: #d6e0e9;
      --soft: #f5f8fb;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #ffffff;
      color: var(--ink);
      font-family: Arial, Helvetica, sans-serif;
    }

    .epa-identity {
      width: 100%;
      background: #ffffff;
      padding: clamp(42px, 5vw, 68px) clamp(18px, 5vw, 72px);
    }

    .epa-identity__inner {
      width: min(100%, 1120px);
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(290px, .85fr) minmax(560px, 1.45fr);
      gap: clamp(38px, 5vw, 74px);
      align-items: center;
    }

    .epa-identity__title {
      margin: 0;
      color: var(--navy);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(35px, 4vw, 54px);
      font-weight: 400;
      line-height: 1.06;
    }

    .epa-identity__intro {
      margin: 20px 0 0;
      font-size: clamp(16px, 1.25vw, 18px);
      line-height: 1.68;
    }

    .identity-module {
      min-width: 0;
    }

    .identity-tabs {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 11px;
    }

    .identity-tab {
      --tab-color: var(--blue);
      position: relative;
      min-height: 86px;
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 15px 15px 15px 47px;
      background: #ffffff;
      color: var(--ink);
      cursor: pointer;
      font: inherit;
      text-align: left;
      box-shadow: 0 7px 17px rgba(0, 53, 107, .07);
      transition:
        transform 180ms ease,
        border-color 180ms ease,
        background 180ms ease,
        box-shadow 180ms ease,
        opacity 180ms ease;
    }

    .identity-tab:hover,
    .identity-tab:focus-visible,
    .identity-tab.is-active {
      transform: translateY(-3px);
      border-color: var(--tab-color);
      background: color-mix(in srgb, var(--tab-color) 7%, white);
      box-shadow:
        0 0 0 3px color-mix(in srgb, var(--tab-color) 11%, transparent),
        0 12px 23px rgba(0, 53, 107, .12);
      outline: none;
    }

    .identity-tabs[data-active] .identity-tab:not(.is-active) {
      opacity: .48;
    }

    .identity-tab__icon {
      position: absolute;
      left: 12px;
      top: 14px;
      width: 26px;
      height: 26px;
      border-radius: 8px;
      background: color-mix(in srgb, var(--tab-color) 15%, white);
      color: var(--tab-color);
      display: grid;
      place-items: center;
    }

    .identity-tab__icon svg {
      width: 15px;
      height: 15px;
    }

    .identity-tab__label {
      display: block;
      color: var(--navy);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 16px;
      line-height: 1.2;
    }

    .tab-collaboration { --tab-color: var(--teal); }
    .tab-methods { --tab-color: var(--purple); }
    .tab-backgrounds { --tab-color: var(--gold); }
    .tab-rigor { --tab-color: var(--blue); }

    .identity-detail {
      margin-top: 14px;
      min-height: 172px;
      border-left: 6px solid var(--teal);
      border-radius: 14px;
      padding: 19px 21px;
      background: var(--soft);
      transition: border-color 180ms ease;
    }

    .identity-detail__label {
      margin: 0 0 7px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .07em;
      text-transform: uppercase;
    }

    .identity-detail__title {
      margin: 0;
      color: var(--navy);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(20px, 1.8vw, 25px);
      font-weight: 400;
      line-height: 1.25;
    }

    .identity-detail__text {
      margin: 10px 0 0;
      font-size: 14px;
      line-height: 1.6;
    }

    @media (max-width: 920px) {
      .epa-identity__inner {
        grid-template-columns: 1fr;
      }

      .epa-identity__copy {
        width: min(100%, 760px);
      }
    }

    @media (max-width: 620px) {
      .epa-identity {
        padding-inline: 16px;
      }

      .identity-tabs {
        grid-template-columns: 1fr;
      }

      .identity-detail {
        min-height: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .identity-tab,
      .identity-detail {
        transition: none;
      }
    }
  </style>
</head>

<body>
  <section class="epa-identity" aria-labelledby="epa-identity-title">
    <div class="epa-identity__inner">
      <div class="epa-identity__copy">
        <h2 id="epa-identity-title" class="epa-identity__title">
          Educational Program Assessment
        </h2>

        <p class="epa-identity__intro">
          The Educational Program Assessment (EPA) team provides expertise in the design, implementation, analysis, and reporting of assessments that explore the impact of teaching and learning programs on campus.
        </p>
      </div>

      <div class="identity-module">
        <div class="identity-tabs">
          <button class="identity-tab tab-collaboration is-active" type="button" data-facet="collaboration" aria-pressed="true">
            <span class="identity-tab__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="8" cy="9" r="3"></circle>
                <circle cx="16" cy="9" r="3"></circle>
                <path d="M3 19c.5-3 2.3-5 5-5s4.5 2 5 5M11 19c.5-3 2.3-5 5-5s4.5 2 5 5"></path>
              </svg>
            </span>
            <span class="identity-tab__label">Strong collaborations</span>
          </button>

          <button class="identity-tab tab-methods" type="button" data-facet="methods" aria-pressed="false">
            <span class="identity-tab__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M4 6h16M4 12h16M4 18h16"></path>
                <circle cx="8" cy="6" r="2"></circle>
                <circle cx="15" cy="12" r="2"></circle>
                <circle cx="10" cy="18" r="2"></circle>
              </svg>
            </span>
            <span class="identity-tab__label">Educational research design that emphasizes mixed methodologies</span>
          </button>

          <button class="identity-tab tab-backgrounds" type="button" data-facet="backgrounds" aria-pressed="false">
            <span class="identity-tab__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M4 19h16M6 16V8M12 16V5M18 16v-6"></path>
              </svg>
            </span>
            <span class="identity-tab__label">Learning science, cognitive psychology, and neuroscience</span>
          </button>

          <button class="identity-tab tab-rigor" type="button" data-facet="rigor" aria-pressed="false">
            <span class="identity-tab__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M4 12h16"></path>
                <path d="M7 8l-3 4 3 4M17 8l3 4-3 4"></path>
              </svg>
            </span>
            <span class="identity-tab__label">Rigorous and Realistic Assessment</span>
          </button>
        </div>

        <div class="identity-detail" aria-live="polite">
          <p class="identity-detail__label">Strong collaborations</p>
          <h3 class="identity-detail__title">
            Our assessment work is built on strong collaborations.
          </h3>
          <p class="identity-detail__text">
            Most projects begin with a consultation with us where you can share ideas and meet a member of our team. Strong communication with program leaders that allows reflection and iteration based on the data is a hallmark of this model.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const tabsWrap = document.querySelector(".identity-tabs");
    const tabs = Array.from(document.querySelectorAll(".identity-tab"));
    const detail = document.querySelector(".identity-detail");
    const label = document.querySelector(".identity-detail__label");
    const title = document.querySelector(".identity-detail__title");
    const text = document.querySelector(".identity-detail__text");

    const content = {
      collaboration: {
        color: "#00a6a6",
        label: "Strong collaborations",
        title: "Our assessment work is built on strong collaborations.",
        text: "Most projects begin with a consultation with us where you can share ideas and meet a member of our team. Strong communication with program leaders that allows reflection and iteration based on the data is a hallmark of this model."
      },
      methods: {
        color: "#6b5bd2",
        label: "Educational research design that emphasizes mixed methodologies",
        title: "Our assessment work is built on strong collaborations and educational research design that emphasizes mixed methodologies.",
        text: "Building variation in the modes of data collection offers a more holistic narrative of the function and impact of the program."
      },
      backgrounds: {
        color: "#b38b00",
        label: "Learning science, cognitive psychology, and neuroscience",
        title: "We use our team’s backgrounds in learning science, cognitive psychology, and neuroscience to inform this work.",
        text: ""
      },
      rigor: {
        color: "#286dc0",
        label: "Rigorous and Realistic Assessment",
        title: "We balance the rigor of established assessment approaches with the realistic expectation that data collection needs to be responsive to a program’s dynamic needs.",
        text: "We prioritize embedded and nimble methods that emphasize sustainability and avoid heavy lifts from participants, instructors, and program leaders."
      }
    };

    function showFacet(id) {
      const item = content[id];

      tabsWrap.dataset.active = id;
      detail.style.borderLeftColor = item.color;
      label.textContent = item.label;
      title.textContent = item.title;
      text.textContent = item.text;
      text.hidden = !item.text;

      tabs.forEach(tab => {
        const active = tab.dataset.facet === id;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-pressed", active ? "true" : "false");
      });
    }

    tabs.forEach(tab => {
      const id = tab.dataset.facet;
      tab.addEventListener("mouseenter", () => showFacet(id));
      tab.addEventListener("focus", () => showFacet(id));
      tab.addEventListener("click", () => showFacet(id));
    });

    showFacet("collaboration");
  </script>
</body>
</html>
